# Lumina AI Chat - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# WEB SEARCH (Optional)
# Configure one of these providers for web search functionality
# =============================================================================

# Explicit provider selection (optional - auto-detects based on available keys)
# Options: tavily, serper, brave, searxng, mock
# WEB_SEARCH_PROVIDER=

# Tavily Search API (https://tavily.com)
# TAVILY_API_KEY=

# Serper (Google Search API - https://serper.dev)
# SERPER_API_KEY=

# Brave Search API (https://brave.com/search/api)
# BRAVE_SEARCH_API_KEY=
# BRAVE_API_KEY=

# SearXNG (self-hosted - https://docs.searxng.org)
# SEARXNG_BASE_URL=http://localhost:8080

# =============================================================================
# NOTES
# =============================================================================
# - API keys for LLM providers (OpenRouter, OpenAI, Anthropic, etc.) are
#   stored client-side in IndexedDB and configured via the Settings page
# - This is a BYOK (Bring Your Own Key) application
# - Web search keys are optional server-side configuration
